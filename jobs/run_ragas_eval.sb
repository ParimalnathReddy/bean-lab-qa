#!/bin/bash
#SBATCH --job-name=ragas_eval
#SBATCH --time=04:00:00
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=32GB
#SBATCH --gpus=v100:1
#SBATCH --partition=gpu
#SBATCH --output=/mnt/research/BeanLab/Parimal/BEAN_LLM/hpcc-llm-qa/logs/ragas_eval_%j.out
#SBATCH --error=/mnt/research/BeanLab/Parimal/BEAN_LLM/hpcc-llm-qa/logs/ragas_eval_%j.err

################################################################################
# SLURM Job Script for RAGAS Evaluation (Change 4)
#
# This script:
# 1. Starts Ollama (same model/server as the production QA pipeline)
# 2. Runs eval_ragas.py: generates answers for all 75 benchmark questions via
#    the real BeanRetriever + Ollama pipeline, then scores them with RAGAS
#    metrics judged by Gemini (faithfulness, answer_relevancy, and the
#    reference-free context_precision variant — see eval_ragas.py's
#    docstring for why context_recall needs ground_truth to be populated
#    first, and isn't available out of the box)
# 3. Cleans up when done
#
# REQUIRED: set GEMINI_API_KEY (or Googlegeminiapi) before submitting, e.g.:
#   export Googlegeminiapi="your-key-here"
#   sbatch jobs/run_ragas_eval.sb
# This job does NOT hardcode a key — it inherits whatever is exported in your
# shell environment at submission time (sbatch propagates the environment by
# default). Get a free key at https://aistudio.google.com/apikey
#
# SCHEDULING "nightly or on every code change": SLURM has no built-in cron.
# On HPCC, the usual mechanism is your own crontab on a login node:
#   crontab -e
#   0 2 * * *  cd /mnt/research/BeanLab/Parimal/BEAN_LLM/hpcc-llm-qa && \
#              Googlegeminiapi="your-key" sbatch jobs/run_ragas_eval.sb
# "On every code change" requires a CI system (e.g. GitHub Actions) wired to
# this repo, which is a separate piece of infrastructure this job script does
# not set up.
################################################################################

echo "========================================"
echo "RAGAS Evaluation Job"
echo "========================================"
echo "Job ID: $SLURM_JOB_ID"
echo "Node: $SLURM_NODELIST"
echo "GPU: $CUDA_VISIBLE_DEVICES"
echo "Start time: $(date)"
echo "========================================"
echo ""

# Project directory
PROJECT_DIR="/mnt/research/BeanLab/Parimal/BEAN_LLM/hpcc-llm-qa"
cd "$PROJECT_DIR"

mkdir -p logs data

if [ -z "${Googlegeminiapi}${GEMINI_API_KEY}" ]; then
    echo "ERROR: No Gemini API key found in the environment."
    echo "Set Googlegeminiapi or GEMINI_API_KEY before submitting this job."
    exit 1
fi

# Clear conflicting modules and load required ones
module purge
module load Ollama/0.15.5

# Activate conda environment using hardcoded path (avoids module conflict with Python)
CONDA_BASE="/opt/software-current/2023.06/x86_64/generic/software/Miniforge3/25.11.0-1"
source "${CONDA_BASE}/etc/profile.d/conda.sh"
conda activate /mnt/scratch/kodumuru/conda/envs/bean_llm

echo "Python version:"
python3 --version
echo "Ollama version: $(ollama --version)"
echo ""

# Fix libstdc++ compatibility
export LD_LIBRARY_PATH=/mnt/scratch/kodumuru/conda/envs/bean_llm/lib:$LD_LIBRARY_PATH
export PYTHONUNBUFFERED=1

# Set Ollama environment variables
export OLLAMA_MODELS="${PROJECT_DIR}/models/ollama"
export OLLAMA_HOST="0.0.0.0:11434"
export OLLAMA_NUM_PARALLEL=1

echo "OLLAMA_MODELS=${OLLAMA_MODELS}"
echo "OLLAMA_HOST=${OLLAMA_HOST}"
echo ""

# Start Ollama server
echo "Starting Ollama server..."
bash scripts/start_ollama.sh

if [ $? -ne 0 ]; then
    echo "ERROR: Failed to start Ollama server"
    exit 1
fi

echo "✓ Ollama server running"
echo ""

# Wait for server to fully initialize
sleep 5

echo "Available models:"
ollama list
echo ""

# Run RAGAS evaluation
echo "Running RAGAS evaluation (75 questions)..."
echo ""

python3 src/eval_ragas.py \
    --vector-db "${PROJECT_DIR}/vector_db" \
    --model "llama3.1:8b" \
    --output "${PROJECT_DIR}/data/ragas_results.json" \
    --log-file "${PROJECT_DIR}/logs/ragas_eval_${SLURM_JOB_ID}.log"

EXIT_CODE=$?

echo ""
echo "========================================"
echo "Job Complete!"
echo "Exit code: $EXIT_CODE"
echo "End time: $(date)"
echo "========================================"

if [ $EXIT_CODE -eq 0 ]; then
    echo ""
    echo "Results:"
    cat "${PROJECT_DIR}/data/ragas_results.json" 2>/dev/null | python3 -c "
import json, sys
d = json.load(sys.stdin)
print(f\"  Timestamp: {d['timestamp']}\")
print(f\"  Answered: {d['answered_with_context']}/{d['total_questions']}\")
print(f\"  Aggregate: {d['aggregate']}\")
" 2>/dev/null || echo "  (could not parse results file for summary)"
fi

# Cleanup
echo "Stopping Ollama server..."
pkill ollama 2>/dev/null
echo "✓ Server stopped"

exit $EXIT_CODE
